<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modello: sostituisci __HOME__ con la tua cartella utente (es. /Users/nome) e BUDGET_XLSX con il tuo file, poi copialo in ~/Library/LaunchAgents/ (vedi README). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.budgetapp.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/uv</string>
    <string>run</string>
    <string>--directory</string>
    <string>__HOME__/Documents/BudgetApp</string>
    <string>uvicorn</string>
    <string>server.main:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8765</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BUDGET_XLSX</key><string>__HOME__/Library/Mobile Documents/com~apple~CloudDocs/excel/Budget_Tracker_Modello.xlsx</string>
    <key>BUDGET_AI</key><string>cli</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>PATH</key><string>__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>__HOME__/Documents/BudgetApp</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Documents/BudgetApp/logs/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Documents/BudgetApp/logs/server.log</string>
</dict>
</plist>
